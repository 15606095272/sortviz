{
  "name": "sortviz",
  "version": "0.1.0",
  "description": "排序可视化实验室",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "vite build --config vite.config.single.ts && node scripts/inline-single.mjs",
    "preview": "vite preview",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "verify:code": "VERIFY_ALL_LANGS=1 vitest run tests/algorithms/code-executes.test.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
